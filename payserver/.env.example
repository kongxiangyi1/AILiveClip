# ===== 支付宝 AI 按量付费（A2M）配置 =====
# 沙箱联调默认值已填好；生产部署时把 GATEWAY 改成生产网关、SERVICE_ID 改成服务市场真实 serviceId
ALIPAY_APP_ID=
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_SELLER_ID=           # 商户 ID，2088 开头
ALIPAY_SERVICE_ID=api_mock_service_id
# 应用私钥（PKCS#1，无 PEM 头尾的原始 Base64），建议用文件路径注入，不写进环境变量
ALIPAY_APP_PRIVATE_KEY_FILE=./keys/app_private_key.pem
ALIPAY_ALIPAY_PUBLIC_KEY_FILE=./keys/alipay_public_key.pem

# ===== 买断授权码签发（独立于支付宝应用私钥）=====
# 必须与 ai-live-clip skill 包内 config.json 的 public_key_pem 成对的私钥
# 本机即 C:\Users\KONGXY\.ai-live-clip\keys\private_key.pem（与 config.json 公钥已核对一致）
LICENSE_PRIVATE_KEY_FILE=C:/Users/KONGXY/.ai-live-clip/keys/private_key.pem

# ===== 业务 =====
AI_CLIP_PRICE_CNY=19.90      # 必须与支付宝登记价、SkillHub 展示价三处一致
AI_CLIP_RESOURCE_PATH=/api/license
AI_CLIP_GOODS_NAME=直播切片工具·买断授权
ALIPAY_SELLER_NAME=直播切片工具
