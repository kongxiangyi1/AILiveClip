# 复制为 config.env 并填入真实值; 密钥只放服务端环境变量/KMS, 严禁入库/入技能包/入日志
# 未签约支付宝 AI按量付费前, 保持 ALIPAY_MOCK=1 即可本地全链路联调

ALIPAY_MOCK=1

# ---- 以下签约后填写(支付宝开放平台) ----
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=            # 应用私钥: Python(非 Java)必须用 PKCS#1 原始 Base64
                                   # = 沙箱返回的 appPrivatePkcsKey; 禁 PEM 头尾/换行/转 PKCS#8
ALIPAY_PUBLIC_KEY=                 # 支付宝公钥
ALIPAY_SELLER_ID=                  # 卖家 2088ID
ALIPAY_SELLER_NAME=                # 收款方名称
ALIPAY_SERVICE_ID=                 # AI按量付费 service_id (API_ 开头真实值, 沙箱 api_mock_service_id 仅调试)
ALIPAY_GATEWAY=                    # 留空=沙箱网关(默认); 生产才填 https://openapi.alipay.com/gateway.do

# ---- 计费 ----
PRICE_YUAN=1.00                    # 单次调用价格(元), 必须与 SkillHub 发布表单定价一致
GOODS_NAME=直播切片工具·按量付费
BILL_DB=data/orders.db
